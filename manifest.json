{
  "manifest_version": 3,
  "name": "AI Reading Assistant",
  "version": "0.1.0",
  "description": "Korean AI reading assistant for understanding English text with context, structure, and learning feedback.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "https://api.openai.com/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "AI Reading Assistant",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; connect-src 'self' https://api.openai.com https://* http://* file:"
  }
}
